# Copy to .env to override defaults. Optional: docker compose works without a .env file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=experiment
# Host port for http://localhost:<APP_PORT>
APP_PORT=8000
# Optional. Without it (or with ai.provider: scripted) AI seats use the scripted agent.
ANTHROPIC_API_KEY=
# Optional. Used when ai.provider is gemini.
GEMINI_API_KEY=
